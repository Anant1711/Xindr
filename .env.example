# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL and anon (public) key. Safe in the browser because RLS is on.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Used by app/api/account/delete/route.ts and scripts/seed-dev.ts.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL, used for share links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local only. Must be "true" for scripts/seed-dev.ts to run.
ALLOW_DEV_SEED=false
